<launch>

  <arg name="rviz" default="false" />
  <arg name="dataset" default="subt_mrs" doc="Dataset name for evaluation" />

  <!-- Load configuration parameters -->
  <rosparam file="$(find super_lio)/config/subt_mrs.yaml" command="load"/>

  <!-- Launch Super-LIO Node -->
  <node pkg="super_lio" type="super_lio_node" name="super_lio_node" output="screen" required="true">
    <!-- Remap topics if needed for different dataset formats -->
    <!-- Standard SubT_MRS topic names are already in config file -->
  </node>

  <!-- Optional RViz -->
  <group if="$(arg rviz)">
    <node pkg="rviz" type="rviz" name="super_lio_rviz" args="-d $(find super_lio)/rviz/lio.rviz" />
  </group>

</launch>
